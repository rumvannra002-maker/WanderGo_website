rules_version = '2';

// Security model:
// - Reader (not logged in, or logged in with role "user"): can VIEW
//   everything freely, and can submit bookings/messages.
// - Admin (role == "admin" on their /users/{uid} profile doc): can also
//   create/update/delete site content (destinations, packages), manage
//   bookings/messages, and manage other users' roles.
//
// Signing up no longer grants admin access by itself — only the very first
// account ever created (bootstrapped client-side in AuthContext) starts as
// admin; everyone after that starts as "user" and must be promoted by an
// existing admin from Admin > Users. The UI already hides admin-only
// controls for non-admins, but that is only a convenience — anyone could
// still call Firestore directly from a browser console, so these rules are
// what actually enforce it server-side. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Destinations shown on the Home page ("posts").
    // Everyone can read. Only admins can create/update/delete.
    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tour packages/products shown on the Home page.
    // Everyone can read. Only admins can create/update/delete.
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contact form submissions.
    // Anyone can submit a message; only admins can read/manage them.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Booking requests from the Services page.
    // Anyone can submit a booking; only admins can read/manage them.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Tiny public flag used only to bootstrap the very first admin
    // account on signup (see AuthContext.jsx). Readable by anyone
    // (including signed-out visitors, who need to check it before their
    // account even exists) so it can never leak user data — it holds a
    // single boolean. It can be created once (adminCreated: true) and can
    // never be flipped back to false afterwards.
    match /meta/bootstrap {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.adminCreated == true;
      allow update: if isSignedIn() &&
        resource.data.adminCreated == false && request.resource.data.adminCreated == true;
      allow delete: if false;
    }

    // User profiles (role lives here). Created automatically on signup.
    match /users/{userId} {
      // Admins can see and manage everyone; a user can read/create their
      // own profile doc, but cannot write their own "role" field (only an
      // existing admin can promote/demote via the Users page).
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
